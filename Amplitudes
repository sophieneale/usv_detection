    "def plot_parameter_comparison(parameters):\n",
    "    \"\"\"\n",
    "    Create comprehensive comparison plots for 6 parameters\n",
    "    \"\"\"\n",
    "    # Extract data\n",
    "    param_names = list(parameters.keys())\n",
    "    total_detected = [parameters[p]['total_detected'] for p in param_names]\n",
